{
  "rewrites": [
    {
      "source": "/teach",
      "destination": "/index.html"
    },
    {
      "source": "/screen",
      "destination": "/index.html"
    },
    {
      "source": "/j/:code",
      "destination": "/index.html"
    },
    {
      "source": "/:code([A-Za-z0-9]{3,8})",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
